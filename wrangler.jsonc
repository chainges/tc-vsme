{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tc-vsme",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "tc-vsme-staging",
      "workers_dev": true
    },
    "production": {
      "name": "tc-vsme-production",
      "workers_dev": true
    }
  }
}